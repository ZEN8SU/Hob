# ===================================================================
# Hyperlocal Peer-to-Peer (P2P) Micro-Tasking Platform (HOB)
# Production Environment Variables & Deployment Configuration
# ===================================================================

# -------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / Railway)
# -------------------------------------------------------------------
# Connect to Postgres via connection pooling (Transaction mode for Prisma)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations and schema push (Session mode)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@your-db-host.supabase.com:5432/postgres"

# -------------------------------------------------------------------
# 2. APPLICATION & SERVER SETTINGS
# -------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET="generate_a_secure_64_character_random_hex_key_here_2025"

# Platform Escrow Commission Percentage (15% Default)
PLATFORM_FEE_PERCENTAGE=15

# -------------------------------------------------------------------
# 3. RAZORPAY ESCROW GATEWAY
# -------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_or_test_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# -------------------------------------------------------------------
# 4. EMAIL & SMTP OTP GATEWAY (Nodemailer / Resend / SendGrid / AWS SES)
# -------------------------------------------------------------------
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM='"HOB Platform" <no-reply@yourdomain.com>'

# -------------------------------------------------------------------
# 5. FRONTEND ENVIRONMENT CONFIGURATION (Next.js / Vercel)
# -------------------------------------------------------------------
# Point frontend to backend API URL (e.g. Render / Railway deployment URL)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
